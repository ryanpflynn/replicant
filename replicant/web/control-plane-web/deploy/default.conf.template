# control-plane-web (WS-07): static SPA + same-origin proxy of /v1 to control-plane-api.
# Rendered by the nginx image's envsubst step: NGINX_PORT, REPLICANT_API_UPSTREAM (compose), NGINX_RESOLVER
# (15-resolver.envsh, from /etc/resolv.conf). The upstream is resolved per request, so a recreated
# control-plane-api container (new IP) does not break the proxy.
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

server {
    listen ${NGINX_PORT};
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /v1/ {
        set $api_upstream ${REPLICANT_API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # SSE (/v1/stream, run live tails) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 1h;
        client_max_body_size 2m;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
