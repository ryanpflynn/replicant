#!/bin/sh
# Sourced by the nginx image entrypoint before templates are rendered: the container's DNS server for `resolver`.
ns=$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf 2>/dev/null)
case "$ns" in *:*) ns="[$ns]" ;; "") ns=127.0.0.11 ;; esac
export NGINX_RESOLVER="${NGINX_RESOLVER:-$ns}"
