#!/bin/sh
# Sourced by the nginx image entrypoint before envsubst: the resolver nginx uses for per-request upstreams is the
# container's own nameserver (Docker 127.0.0.11, Podman aardvark-dns at the network gateway).
REPLICANT_SBX_EDGE_RESOLVER="$(awk '/^nameserver/ {print $2; exit}' /etc/resolv.conf)"
export REPLICANT_SBX_EDGE_RESOLVER="${REPLICANT_SBX_EDGE_RESOLVER:-127.0.0.11}"
