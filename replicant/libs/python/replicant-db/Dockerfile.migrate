# One-shot `migrate` image (compose service `migrate`; prod: the migrate Job). Build context: monorepo root.
#   podman build -f libs/python/replicant-db/Dockerfile.migrate -t localhost/replicant/migrate:dev .
FROM docker.io/library/python:3.12-slim
ARG REPLICANT_BUILD_ID=b20261024-000000000000
ARG REPLICANT_GIT_SHA=000000000000
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    REPLICANT_GIT_SHA=${REPLICANT_GIT_SHA}
LABEL org.opencontainers.image.title="replicant-migrate" org.opencontainers.image.version="${REPLICANT_BUILD_ID}"
COPY libs/python/replicant-db /src/replicant-db
RUN pip install --no-cache-dir /src/replicant-db && rm -rf /src && replicant-db --help >/dev/null
USER 65532:65532
CMD ["replicant-db", "migrate", "--to", "head", "--advisory-lock", "--verify-drift", "--ensure-roles"]
