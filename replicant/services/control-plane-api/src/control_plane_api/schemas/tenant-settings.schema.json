{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/ws07/tenant-settings/v1.json",
  "title": "Tenant operational settings",
  "description": "WS-07. Stored in tenancy.tenant_settings (writer control-plane-api). Operational configuration only (ADR-013): where to deliver, how much capacity, emergency stops. Never changes how an agent behaves; behavioural policy lives in bundles. Kill switches moved to tenancy.kill_switches (all scopes, architecture.md \u00a72.9).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "readOnly": true
    },
    "approval_targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approval_channel": {
              "type": "string",
              "pattern": "^C[A-Z0-9]{2,30}$"
            },
            "escalation_target_1": {
              "type": "string",
              "pattern": "^C[A-Z0-9]{2,30}$"
            },
            "escalation_target_2": {
              "type": "string",
              "pattern": "^C[A-Z0-9]{2,30}$"
            },
            "notifications_channel": {
              "type": "string",
              "pattern": "^C[A-Z0-9]{2,30}$"
            },
            "workspace": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "team_id": {
                  "type": "string",
                  "maxLength": 32
                },
                "enterprise_id": {
                  "type": "string",
                  "maxLength": 32
                }
              }
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "escalation_team": {
              "type": "string",
              "pattern": "^@[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
            }
          }
        },
        "suggested_approver_rotation": {
          "type": "string",
          "enum": [
            "least_recent_decision",
            "none"
          ]
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "description": "Within platform caps (admin:platform sets caps; tenant admins set values up to the cap)",
      "properties": {
        "max_concurrent_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "max_active_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "max_waiting_external_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "max_jobs_per_day": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "max_jobs_per_requester_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "monthly_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Required (R2-055); default platform_caps.tenant_monthly_usd_default; \u2264 tenant_monthly_usd_max"
        },
        "budget_alert_thresholds_pct": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "maxItems": 5
        },
        "daily_budget_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Required (R2-055); default platform_caps.tenant_daily_usd_default; \u2264 tenant_daily_usd_max"
        }
      },
      "required": [
        "monthly_budget_usd",
        "daily_budget_usd"
      ]
    },
    "on_requester_deprovisioned": {
      "type": "string",
      "enum": [
        "pause_and_notify_tenant_admins",
        "cancel",
        "reassign_to_manager"
      ]
    },
    "on_contested_decision": {
      "type": "string",
      "enum": [
        "notify",
        "reopen_if_unpublished"
      ]
    },
    "repair_trigger_min_permission": {
      "type": "string",
      "enum": [
        "write",
        "maintain",
        "admin"
      ]
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site": {
          "type": "string",
          "maxLength": 255
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "maxItems": 50
        },
        "trigger_label": {
          "type": "string",
          "maxLength": 50
        },
        "repo_mapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    }
  },
  "required": [
    "quotas"
  ]
}
