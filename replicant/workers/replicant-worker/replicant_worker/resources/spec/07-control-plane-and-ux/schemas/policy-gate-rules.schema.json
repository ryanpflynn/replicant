{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/kinds/policy-gate_rules/v1.json",
  "title": "Policy spec: gate_rules",
  "description": "WS-07. Validates Policy.spec when policyType=gate_rules. Decides deterministically which gates a job gets (from risk level, workflow type, and JobRequest.constraints.require_gates, which can only add gates, D-19), who is eligible to decide (GateView.eligible), and the reminder/escalation/expiry schedule. Tenant layers may only tighten (add gates, shorten expiry, raise min_repo_permission, set requester_may_decide=false) per ADR-013's mechanical tightening check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyType",
    "gates"
  ],
  "properties": {
    "policyType": {
      "const": "gate_rules"
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/gate_rule"
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean",
          "default": true
        },
        "max_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 21
        },
        "delegate_must_be_eligible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "quiet_hours": {
      "description": "Reminders and escalations scheduled inside quiet hours (in the approver's Okta timezone) are deferred to the end of the window. Expiry is never deferred.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "weekends": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^P(?:[0-9]+D)?(?:T(?:[0-9]+H)?(?:[0-9]+M)?)?$",
      "description": "ISO 8601 duration subset: PnDTnHnM"
    },
    "level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "gate_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gate_kind",
        "when",
        "eligible",
        "timing"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{2,80}$"
        },
        "gate_kind": {
          "type": "string",
          "enum": [
            "plan_approval",
            "publish_approval",
            "clarification",
            "budget_extension",
            "bundle_migration",
            "leak_purge"
          ]
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "risk_at_least": {
              "$ref": "#/$defs/level"
            },
            "workflow_type_in": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "bugfix",
                  "feature",
                  "api_change",
                  "docs",
                  "hotfix",
                  "maintenance",
                  "pr_repair",
                  "qa_only"
                ]
              }
            },
            "repos_any": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 512
              }
            },
            "always": {
              "type": "boolean"
            },
            "any_of": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "risk_at_least": {
                    "$ref": "#/$defs/level"
                  },
                  "workflow_type_in": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "repos_any": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "always": {
                    "type": "boolean"
                  }
                }
              },
              "description": "OR of conditions (e.g. 'feature or api_change, or risk \u2265 high'); WS-01 example's always_for maps here"
            }
          }
        },
        "eligible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_repo_permission"
          ],
          "properties": {
            "okta_groups": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "codeowners_of_changed_paths": {
              "type": "boolean",
              "description": "Resolve CODEOWNERS of the diff's paths (users and teams \u2192 linked principals) at gate open; teams resolved through GitHub team membership"
            },
            "requester": {
              "type": "boolean",
              "description": "The requester is the decider (clarification, bundle_migration). For budget_extension the requester decides only when the amount is \u2264 budgets.extension.requesterSelfApproveMaxUsd (WS-09 G-07, default 0): GateRouting then sets requester_may_decide=false and the requester is notified, not asked"
            },
            "min_repo_permission": {
              "type": "string",
              "enum": [
                "admin",
                "maintain",
                "write",
                "triage",
                "read"
              ]
            },
            "requester_may_decide": {
              "type": "boolean",
              "default": false
            },
            "exclude_authors_of_last_commit": {
              "type": "boolean",
              "default": false
            },
            "min_approvers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5,
              "default": 1,
              "description": "C-MSG 1.5.0 eligible.min_approvers; >1 only for leak_purge in v1"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expires_after"
          ],
          "properties": {
            "reminders": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/duration"
              },
              "description": "Offsets from gate open"
            },
            "escalations": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "after",
                  "to"
                ],
                "properties": {
                  "after": {
                    "$ref": "#/$defs/duration"
                  },
                  "to": {
                    "type": "string",
                    "enum": [
                      "escalation_target_1",
                      "escalation_target_2",
                      "tenant_admins",
                      "requester_manager"
                    ]
                  },
                  "widen_eligibility": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, members of the escalation target also become eligible deciders from this point (still subject to repo permission)"
                  }
                }
              }
            },
            "expires_after": {
              "$ref": "#/$defs/duration"
            },
            "on_expiry": {
              "type": "string",
              "enum": [
                "expire",
                "decline",
                "keep_open_and_alert"
              ],
              "default": "expire",
              "description": "expire: gate expired, job ends `expired` (outcome gate_expired). decline: treated as a reject decision by the system (bundle_migration: stay on the current bundle unless the migration was required, then the job ends cancelled). keep_open_and_alert: never expires; alerts tenant admins daily"
            },
            "expiry_bounded_by_base_drift": {
              "type": "boolean",
              "default": true,
              "description": "publish gates: if the base branch moved more than max_base_drift_commits, approval triggers rebase and re-verify (D-19)"
            },
            "reminder_repeat": {
              "$ref": "#/$defs/duration",
              "description": "After the last listed reminder, repeat at this interval until expiry"
            },
            "expiry_deferred_in_quiet_hours": {
              "type": "boolean",
              "default": false,
              "description": "If true, expiry is pushed past the decider's quiet hours and weekends (R2-022). Default true for budget_extension and requester-only gates in the base layer"
            }
          }
        },
        "batchable": {
          "type": "boolean",
          "default": false
        },
        "channels_override": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ui",
              "slack",
              "github",
              "cli"
            ]
          },
          "description": "Narrow the channels from approval_channels for this gate (never widen)"
        },
        "reapprove_after_rebase": {
          "type": "string",
          "enum": [
            "on_conflict_or_risk_change",
            "always",
            "never"
          ],
          "default": "on_conflict_or_risk_change",
          "description": "publish_approval: whether a rebase after approval opens a new gate (ordinal+1)"
        }
      }
    }
  }
}
