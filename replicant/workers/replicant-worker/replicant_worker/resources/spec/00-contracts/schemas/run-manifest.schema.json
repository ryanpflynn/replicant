{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/contracts/run-manifest/v1.json",
  "title": "Run manifest",
  "description": "Contract C-ART v2.0.0 (WS-00). Written once, last, by the in-pod uploader to <artifacts prefix>manifest.json with If-None-Match: *. Its presence commits the run's artifacts. Also used (schema replicant.step-manifest/v1) for activity-produced step artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_id",
    "job_id",
    "producer",
    "created_at",
    "partial",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "replicant.run-manifest/v1",
        "replicant.step-manifest/v1"
      ]
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job_[0-9a-hjkmnp-tv-z]{26}$"
    },
    "producer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "run_id",
            "agentrun",
            "role"
          ],
          "properties": {
            "kind": {
              "const": "run"
            },
            "run_id": {
              "type": "string",
              "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "agentrun": {
              "type": "string",
              "pattern": "^ar-[0-9a-hjkmnp-tv-z]{26}$"
            },
            "role": {
              "type": "string",
              "enum": [
                "planner",
                "implementer",
                "qa",
                "reviewer",
                "repair",
                "takeover",
                "eval"
              ]
            },
            "release_bundle_id": {
              "type": "string",
              "pattern": "^rb_[0-9a-hjkmnp-tv-z]{26}$"
            },
            "exit_code": {
              "type": "integer"
            },
            "agent_started_at": {
              "type": "string",
              "format": "date-time"
            },
            "agent_exited_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "step_id",
            "service"
          ],
          "properties": {
            "kind": {
              "const": "step"
            },
            "step_id": {
              "description": "<node_key>.c<cycle>.n<ordinal> (the logical activity id without the effect suffix).",
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,40}\\.c[0-9]{1,3}\\.n[0-9]{1,3}$"
            },
            "service": {
              "type": "string",
              "maxLength": 63
            }
          }
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "partial": {
      "description": "true when written during failure/cancel finalization; some expected artifacts may be missing.",
      "type": "boolean"
    },
    "result": {
      "description": "Artifact entry of type run_result (runs only). Absent if the agent produced none.",
      "$ref": "#/$defs/artifact"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleset_version"
      ],
      "properties": {
        "ruleset_version": {
          "type": "string",
          "maxLength": 64
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated_types": {
          "description": "Artifact types that hit their max size and were truncated.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bucket_class",
        "key",
        "content_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "type": {
          "description": "Registered artifact type (artifact-layout.md section 4).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,40}$"
        },
        "bucket_class": {
          "type": "string",
          "enum": [
            "artifacts",
            "transcripts",
            "session",
            "audit",
            "memory",
            "eval",
            "registry"
          ]
        },
        "key": {
          "description": "Object key (bucket-relative, env-agnostic). Max 1024 bytes UTF-8.",
          "type": "string",
          "maxLength": 1024
        },
        "content_type": {
          "type": "string",
          "maxLength": 127
        },
        "content_encoding": {
          "type": "string",
          "enum": [
            "identity",
            "zstd",
            "gzip"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "redacted": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "name": {
          "description": "Human label (e.g. 'checkout-flow step 3 screenshot').",
          "type": "string",
          "maxLength": 256
        },
        "attributes": {
          "description": "Type-specific small metadata (e.g. {\"viewport\":\"1440x900\",\"test\":\"refund partial\"}).",
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
