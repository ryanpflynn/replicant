{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnRunPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/*",
        "arn:aws:s3:::acme-replicant-prod-transcripts/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/*",
        "arn:aws:s3:::acme-replicant-prod-session/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "s3:x-amz-server-side-encryption": "aws:kms",
          "s3:RequestObjectTag/replicant-tenant": "${aws:PrincipalTag/replicant-tenant}"
        }
      }
    },
    {
      "Sid": "ReadOwnRunInputsAndManifestOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-transcripts/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-session/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/${aws:PrincipalTag/replicant-tenant}/jobs/${aws:PrincipalTag/replicant-job}/runs/${aws:PrincipalTag/replicant-run}/manifest.json"
      ]
    },
    {
      "Sid": "NeverWriteInputsInboxOrAgentrunRecord",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/*/jobs/*/runs/*/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-transcripts/tenants/*/jobs/*/runs/*/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-session/tenants/*/jobs/*/runs/*/inputs/*",
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/*/jobs/*/runs/*/inbox/*",
        "arn:aws:s3:::acme-replicant-prod-artifacts/tenants/*/jobs/*/runs/*/agentrun_record/*"
      ]
    },
    {
      "Sid": "NoListNoDeleteNoAclNoReadOutsideInputs",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:DeleteObject*",
        "s3:PutObjectAcl",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:GetObjectVersion",
        "s3:RestoreObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "TenantKeyViaS3Only",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:us-east-1:111111111111:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com",
          "aws:ResourceTag/replicant-key-class": "tenant",
          "aws:ResourceTag/replicant-tenant": "${aws:PrincipalTag/replicant-tenant}"
        }
      }
    },
    {
      "Sid": "StolenCredentialsUselessOutsideSandboxEndpoint",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:SourceVpce": "vpce-0e1c5ab0d3f4a7b21"
        }
      }
    },
    {
      "Sid": "DenyAllOtherServices",
      "Effect": "Deny",
      "NotAction": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:GetObject",
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "*"
    }
  ]
}
