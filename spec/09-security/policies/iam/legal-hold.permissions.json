{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlaceAndReleaseLegalHolds",
      "Effect": "Allow",
      "Action": [
        "s3:PutObjectLegalHold",
        "s3:GetObjectLegalHold",
        "s3:GetObjectRetention"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-audit/*",
        "arn:aws:s3:::acme-replicant-prod-legal/*"
      ]
    },
    {
      "Sid": "ReadAndPreserveEvidenceInLegalBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-legal/*"
    },
    {
      "Sid": "ReadAuditEvidence",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-audit/*"
    },
    {
      "Sid": "ListBoth",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-audit",
        "arn:aws:s3:::acme-replicant-prod-legal"
      ]
    },
    {
      "Sid": "KeysViaS3",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:111111111111:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        },
        "ForAnyValue:StringEquals": {
          "aws:ResourceTag/replicant-key-class": [
            "audit",
            "legal",
            "tenant"
          ]
        }
      }
    },
    {
      "Sid": "NeverBypassNeverDelete",
      "Effect": "Deny",
      "Action": [
        "s3:BypassGovernanceRetention",
        "s3:PutObjectRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "*"
    }
  ]
}
