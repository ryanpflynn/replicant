# Generated as .env by `replicant dev up` on first run (random values for every secret below). Values that
# third-party images cannot read from files live here; everything else is under $REPLICANT_DEV_HOME/secrets.
REPLICANT_DEV_HOME=./.replicant-dev
REPLICANT_REPO_ROOT=../..
REPLICANT_IMAGE_REGISTRY=localhost/replicant
REPLICANT_IMAGE_TAG=dev
REPLICANT_WORKER_BUILD_ID=b20261024-3f9a1c2e7d4b
REPLICANT_WORKER_NEXT_BUILD_ID=b20261024-8e21c0d4a9f7
REPLICANT_RUNNER_URL=http://runner-local:8480
REPLICANT_GATEWAY_MODE=passthrough
REPLICANT_LOCAL_RUNTIME=runc
REPLICANT_MAX_CONCURRENT_RUNS=2
REPLICANT_OTEL_DISABLED=true
REPLICANT_CONTAINER_SOCKET=/var/run/docker.sock
REPLICANT_CONTAINER_HOST=unix:///var/run/docker.sock
REPLICANT_KATA=auto
REPLICANT_GVISOR=off
REPLICANT_S3_IMPL=seaweedfs
REPLICANT_GATEWAY_REPLAY_MATCH=sequence
REPLICANT_GATEWAY_CASSETTE_SET=
REPLICANT_PG_TEMPORAL_PASSWORD=change-me-generated
REPLICANT_PG_LANGFUSE_PASSWORD=change-me-generated
REPLICANT_CLICKHOUSE_PASSWORD=change-me-generated
REPLICANT_VALKEY_PASSWORD=change-me-generated
REPLICANT_LANGFUSE_SALT=change-me-generated
REPLICANT_LANGFUSE_ENCRYPTION_KEY=change-me-64-hex-generated
REPLICANT_LANGFUSE_NEXTAUTH_SECRET=change-me-generated
REPLICANT_LANGFUSE_SECRET_KEY=sk-lf-change-me-generated
REPLICANT_LANGFUSE_BASIC_AUTH=base64-of-public-key-colon-secret-key-generated
REPLICANT_LANGFUSE_ADMIN_PASSWORD=replicant-local
REPLICANT_S3_LANGFUSE_SECRET=change-me-generated
REPLICANT_OIDC_WEB_SECRET=change-me-generated
REPLICANT_GRAFANA_RO_PASSWORD=change-me-generated
