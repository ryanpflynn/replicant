{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/kinds/release-bundle-request/v1.json",
  "title": "ReleaseBundleRequest",
  "description": "WS-06 (owner of the format per C-DEF section 4.3). Authored in the replicant-config repo under bundles/requests/*.yaml, or generated by the release controller (override requests from the Langfuse webhook, the CLI/model upgrade job, and the improvement proposer). Input to POST /v1/registry/bundles:build. NOT a registry object: it is validated, resolved, and its digest is recorded on the resulting bundle row (registry.release_bundles.request_digest). Exactly one of 'full' (resolve every selector from scratch) or 'overlay' (start from an existing bundle's pinned spec and re-resolve only the overridden selectors, so the resulting diff contains only the intended change).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "replicant.example.com/v1"
    },
    "kind": {
      "const": "ReleaseBundleRequest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owners"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "owners": {
          "description": "Okta groups that must approve changes to this request file (CODEOWNERS is generated from it).",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "labels": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 63
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "changeSummary"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "full",
            "overlay"
          ]
        },
        "changeSummary": {
          "description": "Human summary copied into the bundle's metadata.change_summary.",
          "type": "string",
          "minLength": 3,
          "maxLength": 4000
        },
        "full": {
          "$ref": "#/$defs/fullSpec"
        },
        "overlay": {
          "$ref": "#/$defs/overlaySpec"
        },
        "evaluation": {
          "description": "Requests may raise the eval tier above the diff-derived tier (release-bundle.md section 7), never lower it.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tierFloor": {
              "type": "string",
              "enum": [
                "T0",
                "T1",
                "T2",
                "T3"
              ]
            },
            "requireShadow": {
              "type": "boolean",
              "default": false
            },
            "requireSuperiority": {
              "description": "Set by the improvement proposer: the candidate must show a statistically significant improvement, not only non-inferiority (self-improvement.md section 5).",
              "type": "boolean",
              "default": false
            },
            "expedited": {
              "description": "Security-fix path (promotion.md section 8). Requires two release-manager sign-offs; runs T1 plus the compatibility checks only, then an accelerated canary.",
              "type": "boolean",
              "default": false
            }
          }
        },
        "proposalId": {
          "description": "Set when the request was generated by the improvement proposer (self-improvement.md).",
          "type": "string",
          "pattern": "^prop_[0-9a-hjkmnp-tv-z]{26}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "full"
              }
            }
          },
          "then": {
            "required": [
              "full"
            ],
            "not": {
              "required": [
                "overlay"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "overlay"
              }
            }
          },
          "then": {
            "required": [
              "overlay"
            ],
            "not": {
              "required": [
                "full"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "selector": {
      "description": "Selector grammar from C-DEF 3.0.0 \u00a73: '<kind>/<name>' resolves to the registry head of that name at build time (C-DEF 2.x semantics, CCR-03-02), '<kind>/<name>@<version>' pins a version, 'prompt/<name>@label:<label>' resolves a Langfuse label, 'prompt/<name>@<version>' pins a Langfuse version. A '.<tenant_id>' suffix denotes a tenant-scoped object.",
      "type": "string",
      "maxLength": 300,
      "pattern": "^(agent|environment|graph|policy|nodecatalog)/[a-z][a-z0-9]*(-[a-z0-9]+)*(\\.[a-z][a-z0-9-]{1,31})?(@[1-9][0-9]*)?$|^prompt/[a-z0-9][a-z0-9._/-]{0,199}@(label:[a-z0-9][a-z0-9._-]{0,99}|[1-9][0-9]*)$"
    },
    "workerDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentName",
        "buildId"
      ],
      "properties": {
        "deploymentName": {
          "const": "replicant-worker"
        },
        "buildId": {
          "type": "string",
          "pattern": "^b[0-9]{8}-[0-9a-f]{12}$"
        }
      }
    },
    "graphs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bugfix",
        "feature",
        "api_change",
        "docs",
        "hotfix",
        "maintenance",
        "pr_repair",
        "qa_only"
      ],
      "properties": {
        "bugfix": {
          "$ref": "#/$defs/selector"
        },
        "feature": {
          "$ref": "#/$defs/selector"
        },
        "api_change": {
          "$ref": "#/$defs/selector"
        },
        "docs": {
          "$ref": "#/$defs/selector"
        },
        "hotfix": {
          "$ref": "#/$defs/selector"
        },
        "maintenance": {
          "$ref": "#/$defs/selector"
        },
        "pr_repair": {
          "$ref": "#/$defs/selector"
        },
        "qa_only": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "fullSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workerDeployment",
        "router",
        "graphs",
        "policies",
        "memorySnapshotPolicy"
      ],
      "properties": {
        "workerDeployment": {
          "$ref": "#/$defs/workerDeployment"
        },
        "router": {
          "$ref": "#/$defs/selector"
        },
        "graphs": {
          "$ref": "#/$defs/graphs"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "memorySnapshotPolicy": {
          "$ref": "#/$defs/selector"
        },
        "inWorkerPrompts": {
          "description": "Prompts used by in-worker LLM calls (router intent, feedback triage, memory extraction) that are not reachable from an AgentDefinition. Added to spec.prompts.",
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "inWorkerModels": {
          "description": "Gateway model ids used by in-worker LLM calls. Added to spec.models with used_by 'worker/<purpose>'.",
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "gatewayModelId"
            ],
            "properties": {
              "purpose": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,40}$"
              },
              "gatewayModelId": {
                "type": "string",
                "maxLength": 200,
                "not": {
                  "pattern": "latest$"
                }
              }
            }
          }
        }
      }
    },
    "overlaySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "overrides",
        "declaredChangeClasses"
      ],
      "properties": {
        "base": {
          "description": "The bundle whose pinned spec is the starting point. 'assignment:<env>:default' resolves to the environment's current default base bundle at build time; the resolved id is recorded as lineage.parent_release_bundle_id.",
          "type": "string",
          "pattern": "^(rb_[0-9a-hjkmnp-tv-z]{26}|assignment:(dev|staging|prod):default)$"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "workerDeployment": {
              "$ref": "#/$defs/workerDeployment"
            },
            "router": {
              "$ref": "#/$defs/selector"
            },
            "graphs": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "bugfix": {
                  "$ref": "#/$defs/selector"
                },
                "feature": {
                  "$ref": "#/$defs/selector"
                },
                "api_change": {
                  "$ref": "#/$defs/selector"
                },
                "docs": {
                  "$ref": "#/$defs/selector"
                },
                "hotfix": {
                  "$ref": "#/$defs/selector"
                },
                "maintenance": {
                  "$ref": "#/$defs/selector"
                },
                "pr_repair": {
                  "$ref": "#/$defs/selector"
                },
                "qa_only": {
                  "$ref": "#/$defs/selector"
                }
              }
            },
            "agents": {
              "description": "Replace the pinned version of a named AgentDefinition everywhere it is reachable (e.g. 'agent/implementer-claude@8' for a CLI image bump).",
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/selector"
              }
            },
            "environments": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/selector"
              }
            },
            "policies": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/selector"
              }
            },
            "prompts": {
              "description": "Replace the pinned version of a named prompt (e.g. 'prompt/reviewer-system@label:candidate'). Every agent that references the prompt name picks up the override; the build fails if no agent or in-worker call references it.",
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/selector"
              }
            },
            "memorySnapshotPolicy": {
              "$ref": "#/$defs/selector"
            }
          }
        },
        "declaredChangeClasses": {
          "description": "Change classes (release-bundle.md \u00a75.3) the overlay intends. The build fails with 422 undeclared_change if the resulting diff against the base contains any class not listed (R1-146). Declaring a class also raises the derived tier accordingly.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "prompt",
              "prompt_inworker",
              "model",
              "cli_patch",
              "cli_minor",
              "cli_major",
              "agent_config",
              "environment",
              "graph",
              "router",
              "worker_code",
              "memory_policy",
              "codebase_binding",
              "policy_tightening",
              "policy_neutral",
              "policy_behavioral"
            ]
          }
        }
      }
    }
  },
  "examples": [
    {
      "apiVersion": "replicant.example.com/v1",
      "kind": "ReleaseBundleRequest",
      "metadata": {
        "name": "lf-reviewer-system-v14",
        "owners": [
          "replicant-platform"
        ],
        "description": "Generated by release-controller from Langfuse webhook prompt-version.updated"
      },
      "spec": {
        "mode": "overlay",
        "changeSummary": "reviewer-system prompt v13 -> v14 (label candidate)",
        "overlay": {
          "base": "assignment:prod:default",
          "overrides": {
            "prompts": [
              "prompt/reviewer-system@label:candidate"
            ]
          },
          "declaredChangeClasses": [
            "prompt"
          ]
        }
      }
    }
  ]
}
