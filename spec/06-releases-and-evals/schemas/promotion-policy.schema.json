{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/releases/promotion-policy/v1.json",
  "title": "PromotionPolicy",
  "description": "WS-06. Operational configuration of the release pipeline (promotion.md). Authored at releases/promotion-policy.yaml in the replicant-config repo; published by CI to control-plane-api (POST /v1/releases/promotion-policies), stored versioned in registry.promotion_policies. It is operational, not behavioral (ADR-013): it decides when and whether a bundle reaches jobs, never how an agent behaves, so it is read live by the ReleasePipeline workflow (which records the policy version it used at pipeline start and keeps it for the pipeline's lifetime).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "replicant.example.com/v1"
    },
    "kind": {
      "const": "PromotionPolicy"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "owners"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiers",
        "offlineGates",
        "shadow",
        "canary",
        "rollbackTriggers",
        "signoff",
        "holdback",
        "spend",
        "reruns"
      ],
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "T1",
            "T2",
            "T3"
          ],
          "properties": {
            "T1": {
              "$ref": "#/$defs/tier"
            },
            "T2": {
              "$ref": "#/$defs/tier"
            },
            "T3": {
              "$ref": "#/$defs/tier"
            }
          }
        },
        "offlineGates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxHarnessErrorRate",
            "nonInferiorityMarginPts",
            "maxStableSetFailureRate",
            "maxCostRatioMedian",
            "maxWallRatioP95",
            "maxScopeViolationDeltaPts",
            "judgeMarginOrdinal"
          ],
          "properties": {
            "maxHarnessErrorRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "nonInferiorityMarginPts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "T1",
                "T2",
                "T3"
              ],
              "properties": {
                "T1": {
                  "type": "number"
                },
                "T2": {
                  "type": "number"
                },
                "T3": {
                  "type": "number"
                }
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0.8,
              "maximum": 0.999,
              "default": 0.95
            },
            "maxStableSetFailureRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "maxCostRatioMedian": {
              "type": "number",
              "minimum": 1
            },
            "maxWallRatioP95": {
              "type": "number",
              "minimum": 1
            },
            "maxScopeViolationDeltaPts": {
              "type": "number",
              "minimum": 0
            },
            "judgeMarginOrdinal": {
              "type": "number",
              "minimum": 0
            },
            "strataFlagDropPts": {
              "type": "number",
              "minimum": 0,
              "default": 10
            },
            "interimHarmZ": {
              "description": "O'Brien-Fleming interim boundary at 50% of cases (two looks, overall alpha 0.05): stop for harm when z < -interimHarmZ.",
              "type": "number",
              "default": 2.797
            }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampleRate",
            "minPairs",
            "maxDays",
            "maxUsd",
            "requiredFor"
          ],
          "properties": {
            "sampleRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "minPairs": {
              "type": "integer",
              "minimum": 10
            },
            "maxDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 14
            },
            "maxUsd": {
              "type": "number",
              "minimum": 0
            },
            "requiredFor": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "model",
                  "cli_minor",
                  "cli_major",
                  "graph",
                  "worker_code",
                  "memory_policy",
                  "router"
                ]
              }
            },
            "maxRunFailureDeltaPts": {
              "type": "number",
              "default": 3
            },
            "maxCostRatio": {
              "type": "number",
              "default": 1.3
            }
          }
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stages",
            "evaluationIntervalSeconds"
          ],
          "properties": {
            "evaluationIntervalSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 3600
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "percent",
                  "ring",
                  "minHours",
                  "minCandidateJobs",
                  "advance"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,30}$"
                  },
                  "percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "ring": {
                    "description": "Tenants whose tenancy setting release_ring is in this list are included at 100% for this stage.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "early",
                        "standard",
                        "conservative"
                      ]
                    }
                  },
                  "minHours": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minCandidateJobs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "advance": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "signoff"
                    ]
                  }
                }
              }
            }
          }
        },
        "rollbackTriggers": {
          "description": "Evaluated every canary.evaluationIntervalSeconds against the concurrent control cohort (promotion.md \u00a76.2). Rate triggers have two tiers: 'pause' (ramp frozen, release on-call paged; auto-rollback if not resolved within escalateAfterHours) and 'rollback' (immediate). Operating characteristics: tools/canary_guardrails.py.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "metric",
              "kind",
              "threshold",
              "minCandidateN",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[0-9]{1,2}$"
              },
              "metric": {
                "type": "string",
                "maxLength": 100
              },
              "kind": {
                "type": "string",
                "enum": [
                  "rate_increase_pts",
                  "rate_decrease_pts",
                  "ratio_median",
                  "ratio_p50",
                  "count_any",
                  "same_reason_burst"
                ]
              },
              "threshold": {
                "description": "theta: points for rate kinds, ratio for ratio kinds, count for count kinds.",
                "type": "number"
              },
              "pause": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "probability",
                  "observedMinFraction"
                ],
                "properties": {
                  "probability": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 0.99999
                  },
                  "observedMinFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              },
              "rollback": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "probability",
                  "observedMinFraction"
                ],
                "properties": {
                  "probability": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 0.99999
                  },
                  "observedMinFraction": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  }
                }
              },
              "windowMinutes": {
                "type": "integer",
                "minimum": 5,
                "maximum": 1440
              },
              "minCandidateN": {
                "type": "integer",
                "minimum": 0
              },
              "escalateAfterHours": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 24
              },
              "action": {
                "description": "Action for count, burst and ratio kinds, and the strongest action allowed for rate kinds.",
                "type": "string",
                "enum": [
                  "rollback",
                  "rollback_and_revoke",
                  "pause_ramp",
                  "alert"
                ]
              }
            }
          }
        },
        "signoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "releaseManagerGroup",
            "requiredFor"
          ],
          "properties": {
            "releaseManagerGroup": {
              "type": "string"
            },
            "securityGroup": {
              "type": "string"
            },
            "requiredFor": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "twoPersonFor": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "authorMaySignOff": {
              "type": "boolean",
              "const": false
            }
          }
        },
        "holdback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "percent",
            "days"
          ],
          "properties": {
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "byChangeClass": {
              "description": "Holdback days per change class, overriding `days` (R1-155). A holdback for a class listed in `protected` is never replaced by a later promotion's holdback (promotion.md \u00a712).",
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 30
              }
            },
            "protected": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "spend": {
          "description": "Spend ceilings per category and period (R2-056, R2-061, R2-063; promotion.md \u00a74.7). Checked by eval-worker before each suite, shadow sampling start, and proposer job; budget accounts are enforced by the gateway.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "eval",
            "shadow",
            "proposal",
            "component",
            "total"
          ],
          "properties": {
            "eval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weeklyUsd",
                "monthlyUsd"
              ],
              "properties": {
                "weeklyUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "monthlyUsd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "shadow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weeklyUsd",
                "monthlyUsd"
              ],
              "properties": {
                "weeklyUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "monthlyUsd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "proposal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weeklyUsd",
                "monthlyUsd"
              ],
              "properties": {
                "weeklyUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "monthlyUsd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "component": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weeklyUsd",
                "monthlyUsd"
              ],
              "properties": {
                "weeklyUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "monthlyUsd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "total": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "weeklyUsd",
                "monthlyUsd"
              ],
              "properties": {
                "weeklyUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "monthlyUsd": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "reruns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxInvalidRerunsPerBundle",
            "maxRerollsPerBundle",
            "maxPreemptRetriesPerCase",
            "maxPreemptedFraction"
          ],
          "properties": {
            "maxInvalidRerunsPerBundle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "maxRerollsPerBundle": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "maxPreemptRetriesPerCase": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "maxPreemptedFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          }
        }
      }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goldenSubset",
        "reps",
        "arms",
        "maxParallelCases",
        "maxUsd",
        "maxHours"
      ],
      "properties": {
        "goldenSubset": {
          "type": "string",
          "enum": [
            "smoke",
            "standard",
            "full",
            "targeted"
          ]
        },
        "reps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "arms": {
          "type": "string",
          "enum": [
            "candidate_only",
            "paired",
            "paired_reuse_baseline_7d"
          ]
        },
        "maxParallelCases": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxHours": {
          "type": "number",
          "minimum": 0.5
        }
      }
    }
  }
}
