      "subject_key": "money.arithmetic",
      "title": "Use shopspring/decimal for money",
      "statement": "Represent monetary amounts with github.com/shopspring/decimal.Decimal; never float64. Round half-even to the currency minor unit only at presentation.",
      "rationale": "Reviewer: float rounding caused proration drift (PR #1431).",
      "structured": {
        "prefer": [
          "github.com/shopspring/decimal"
        ],
        "avoid": [
          "float32",
          "float64"
        ],
        "applies_to": "monetary values"
      },
      "examples": [
        {
          "kind": "bad",
          "language": "go",
          "code": "amount := float64(cents) * ratio"
        },
        {
          "kind": "good",
          "language": "go",
          "code": "amount := decimal.NewFromInt(cents).Mul(ratio)"
        }
      ],
