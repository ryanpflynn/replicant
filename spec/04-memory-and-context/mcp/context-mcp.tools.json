    {
      "name": "code_search",
      "title": "Search code across repositories",
      "description": "Indexed lexical search (Zoekt query syntax: regex, repo:, file:, lang:, sym:, case:, -negation) over the default branches of repositories your requester can read. Returns file matches with line context; repositories your requester cannot read are silently excluded. Use your local checkout (grep/ripgrep) for the repository you are changing; use this for other repositories.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1024,
            "description": "e.g. 'sym:PostEntry lang:go -repo:ledger-api'"
          },
          "max_files": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "context_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 2
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "repo",
                "path",
                "matches"
              ],
              "properties": {
                "repo": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "commit_sha": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "matches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "line",
                      "text"
                    ],
                    "properties": {
                      "line": {
                        "type": "integer"
                      },
                      "text": {
                        "type": "string"
                      },
                      "before": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "after": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "annotations": {
        "title": "Search code across repositories",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
