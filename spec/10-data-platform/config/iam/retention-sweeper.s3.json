{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListJobPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-session",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tenants/*/jobs/*"
          ]
        }
      }
    },
    {
      "Sid": "DeleteSessionStateAllVersions",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-session/tenants/*/jobs/*/runs/*"
    },
    {
      "Sid": "WriteDeletionLedgerEntryFirst",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-audit/org/deletion-ledger/*"
    },
    {
      "Sid": "LedgerEntriesWriteOnce",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::acme-replicant-prod-audit/org/deletion-ledger/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      }
    },
    {
      "Sid": "AuditKeyViaS3ForLedger",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:111111111111:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com",
          "aws:ResourceTag/replicant-key-class": "audit"
        }
      }
    },
    {
      "Sid": "NeverDeleteWorkspaceArchives",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-session/tenants/*/jobs/*/runs/*/workspace_archive/*"
    }
  ]
}
