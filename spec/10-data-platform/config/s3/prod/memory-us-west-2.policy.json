{
  "Version": "2012-10-17",
  "Id": "acme-replicant-prod-memory-us-west-2-policy",
  "Statement": [
    {
      "Sid": "DenyNonTls",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2",
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyOutsideOrganization",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2",
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalOrgID": "o-acmereplicant1"
        },
        "Bool": {
          "aws:PrincipalIsAWSService": "false"
        }
      }
    },
    {
      "Sid": "DenyNonKmsEncryption",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "s3:x-amz-server-side-encryption": "aws:kms"
        }
      }
    },
    {
      "Sid": "DenyKeysOutsideEnvironmentKeySet",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*",
      "Condition": {
        "ArnNotLikeIfExists": {
          "s3:x-amz-server-side-encryption-aws-kms-key-id": "arn:aws:kms:us-west-2:111111111111:key/*"
        }
      }
    },
    {
      "Sid": "DenyUnknownRetentionClass",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "s3:RequestObjectTag/replicant-retention": [
            "r1y",
            "r2y"
          ]
        }
      }
    },
    {
      "Sid": "NoBucketConfigChangesExceptPlatformPipeline",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutBucketOwnershipControls",
        "s3:PutLifecycleConfiguration",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration",
        "s3:PutReplicationConfiguration",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketNotification"
      ],
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2",
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*"
      ],
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/replicant-prod-platform-deployer"
        }
      }
    },
    {
      "Sid": "NobodyBypassesRetention",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:BypassGovernanceRetention",
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*"
    },
    {
      "Sid": "DeletesOnlyByNamedRoles",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::111111111111:role/replicant-prod-tenant-offboarding",
            "arn:aws:iam::111111111111:role/replicant-prod-memory-service"
          ]
        }
      }
    },
    {
      "Sid": "MemoryServiceDeletesOnlySnapshotAndMemoryExports",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "NotResource": [
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/tenants/*/snapshots/*",
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/tenants/*/exports/*",
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/org/exports/*"
      ],
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/replicant-prod-memory-service"
        }
      }
    },
    {
      "Sid": "PurgedSnapshotReplacementsWriteOnce",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/tenants/*/snapshots/*.purged-*"
      ],
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      }
    },
    {
      "Sid": "MemoryServiceOnlyDeletesVersions",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::acme-replicant-prod-memory-us-west-2/*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::111111111111:role/replicant-prod-memory-service"
        }
      }
    }
  ]
}
