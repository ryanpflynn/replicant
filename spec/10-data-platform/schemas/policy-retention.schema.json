{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/kinds/policy-retention/v1.json",
  "title": "Policy spec, policyType retention (owner WS-10)",
  "description": "Behavioral retention choices carried in a Release Bundle (C-DEF \u00a72). Per artifact type, the allowed classes are its C-ART 1.9.0 class or a shorter class its bucket accepts (generated by tools/gen_retention_schema.py, so no schema-valid policy can produce a rejected upload). Tightening only (ADR-013), except workflow_history_skeleton r7y, which C-ART allows by policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyType"
  ],
  "properties": {
    "policyType": {
      "const": "retention"
    },
    "artifactRetention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_prompt": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "briefing": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "build_log": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "cli_events": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "diff_bundle": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "feedback_triage": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y"
          ]
        },
        "handoff": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "health_log": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "image_metadata": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "intake_attachment": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "junit_xml": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y"
          ]
        },
        "node_report": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "plan": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "playwright_trace": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "pr_event_payload": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "qa_generated_flow": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y"
          ]
        },
        "qa_report": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "review_report": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "run_inputs": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "sandbox_log": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "sbom": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y",
            "r2y"
          ]
        },
        "screenshot": {
          "enum": [
            "r7d",
            "r30d",
            "r90d",
            "r1y"
          ]
        },
        "steering_message": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "takeover_package": {
          "enum": [
            "r7d",
            "r30d"
          ]
        },
        "task_packet": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "transcript": {
          "enum": [
            "r7d",
            "r30d",
            "r90d"
          ]
        },
        "video": {
          "enum": [
            "r7d",
            "r30d"
          ]
        },
        "workflow_history_skeleton": {
          "enum": [
            "r2y",
            "r7y"
          ]
        }
      }
    },
    "sessionStateGraceDays": {
      "description": "Days after the job's TERMINAL state before cli_session_state (and other run session objects) is purged by the retention sweeper (C-ART job37d). workspace_archive is never swept: it keeps its 30-day lifecycle retention (ruling on R1V-066). The 37-day lifecycle backstop still applies. 0..7; default 7. The sweeper reads it from the job's pinned bundle.",
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "default": 7
    },
    "screenshotsRequireMasking": {
      "description": "If true, producers refuse to upload screenshot artifacts without masking metadata (WS-05/WS-08).",
      "type": "boolean",
      "default": false
    }
  }
}
