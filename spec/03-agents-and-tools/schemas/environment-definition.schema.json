{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.replicant.example.com/kinds/environment-definition/v1.json",
  "title": "EnvironmentDefinition (kind schema v1)",
  "description": "Owner: WS-03 (the qa section: WS-05). Validates a complete EnvironmentDefinition document (C-DEF envelope plus spec). Declarative tool/environment provisioning (D-12): the toolchain image (pinned by digest, built from the declared build spec by config CI), workspace bootstrap steps, environment variables, caches, sidecar services, resource profiles (requests/limits/workspace disk with derivation evidence), isolation hint, and network profile references. Local and production use the same document (D-20).",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://schemas.replicant.example.com/contracts/definition-envelope/v1.json"
    }
  ],
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "replicant.example.com/v1"
    },
    "kind": {
      "const": "EnvironmentDefinition"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codebaseType",
        "image",
        "repo",
        "bootstrap",
        "resourceProfiles",
        "profileByRole",
        "isolationHint",
        "networkProfile",
        "qa"
      ],
      "properties": {
        "codebaseType": {
          "description": "Baseline family used by the resource profile derivation procedure (environment-definition.md section 5).",
          "type": "string",
          "enum": [
            "go_service",
            "nextjs_app",
            "node_service",
            "python_pipeline",
            "python_service",
            "jvm_service",
            "rust_service",
            "docs_site",
            "generic"
          ]
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "repo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fetchDepth": {
              "description": "Default RunSpec.repo.fetch_depth. 0 = full history.",
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 50
            },
            "submodules": {
              "type": "string",
              "enum": [
                "none",
                "recursive"
              ],
              "default": "none"
            },
            "lfs": {
              "type": "boolean",
              "default": false
            },
            "sparse": {
              "description": "Optional cone-mode sparse checkout directories (monorepos).",
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._/-]+$"
              }
            }
          }
        },
        "env": {
          "description": "Non-secret environment for bootstrap steps, the CLI, and every agent shell command.",
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/env_map"
        },
        "packageMirrors": {
          "description": "Named internal mirrors (D-21). The entrypoint writes client config (npm/pnpm/yarn .npmrc, pip.conf, GOPROXY/GONOSUMDB, Maven settings.xml, Gradle init script, Cargo config) pointing at the mirror endpoints the network profile allows. URLs come from the environment's bootstrap config, never from definitions (C-DEF section 2).",
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "npm",
              "pypi",
              "goproxy",
              "maven",
              "gradle-plugins",
              "cargo",
              "rubygems",
              "nuget",
              "oci",
              "apt"
            ]
          }
        },
        "bootstrap": {
          "description": "Steps the entrypoint runs in the workspace after checkout and before the CLI starts (dependency install, codegen). They run as the agent user, inside the run's network profile, and count against active_deadline_seconds. Steps baked into the image belong in image.build.steps instead.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "forRoles": {
              "description": "Roles that run bootstrap. Others (for example planner) skip it.",
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/run_role"
              }
            }
          }
        },
        "caches": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/cache"
          }
        },
        "services": {
          "description": "Sidecar services (D-16; aligned with WS-05). Rendered by the controller as native sidecar containers (initContainers with restartPolicy: Always) in the AgentRun pod, reachable on localhost. Docker-socket approaches (Testcontainers against a daemon) are not supported; Testcontainers users point at these services through TESTCONTAINERS-free configuration (WS-05).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "resourceProfiles": {
          "description": "C-DEF required. Map of profile name to resources. RunSpec.resource_profile selects one; the Runner resolves it into AgentRun spec.resources and spec.workspace.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 10,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "required": [
            "default"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/resourceProfile"
          }
        },
        "profileByRole": {
          "description": "Profile the workflow passes as RunSpec.resource_profile for each role. Roles not listed use default.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "planner": {
              "$ref": "#/$defs/profile_name"
            },
            "implementer": {
              "$ref": "#/$defs/profile_name"
            },
            "repair": {
              "$ref": "#/$defs/profile_name"
            },
            "reviewer": {
              "$ref": "#/$defs/profile_name"
            },
            "qa": {
              "$ref": "#/$defs/profile_name"
            },
            "takeover": {
              "$ref": "#/$defs/profile_name"
            },
            "eval": {
              "$ref": "#/$defs/profile_name"
            }
          }
        },
        "isolationHint": {
          "description": "C-DEF required. Advisory per workload class (RunSpec.isolation_hint); runtime_selection policy decides (WS-02).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coding": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/isolation"
            },
            "qa_build": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/isolation"
            },
            "review": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/isolation"
            },
            "utility": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/isolation"
            }
          }
        },
        "networkProfile": {
          "description": "C-DEF required. Network profile name per workload class (names defined by the network_profiles policy, WS-02/WS-09). Bundle build checks every name exists in the bundle's network_profiles policy.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coding"
          ],
          "properties": {
            "coding": {
              "$ref": "#/$defs/network_profile_name"
            },
            "qa_build": {
              "$ref": "#/$defs/network_profile_name"
            },
            "review": {
              "$ref": "#/$defs/network_profile_name"
            },
            "utility": {
              "$ref": "#/$defs/network_profile_name"
            }
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxOutputBytes": {
              "description": "Default RunSpec.limits.max_output_bytes.",
              "type": "integer",
              "minimum": 1048576,
              "default": 4294967296
            }
          }
        },
        "qa": {
          "description": "QA/QE configuration. OWNED BY WS-05: its schema replicant.env-qa/v1 validates this object; this kind schema only requires the discriminator so WS-05 can evolve it without a WS-03 change.",
          "type": "object",
          "required": [
            "schema"
          ],
          "properties": {
            "schema": {
              "const": "replicant.env-qa/v1"
            }
          }
        },
        "budgets": {
          "description": "Per-job compute budget (XD-FIX-R2-064). WS-01 checks it before dispatching each run against cost.run_resource_usage for the job and fails the job budget_exceeded when exceeded.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "computeUsdPerJob": {
              "description": "Decimal USD of compute (CPU, memory, workspace) per job, priced by usage-ingestor. Default 50.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10000,
              "default": 50
            }
          }
        }
      }
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "network_profile_name": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "image": {
      "description": "Toolchain image strategy (environment-definition.md section 7). Authors edit build; config CI builds it, signs it, and writes resolved (bot commit on the PR). Publish rejects a document whose resolved.buildSpecDigest differs from sha256(JCS(build)) or whose image lacks a valid signature and SLSA provenance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build",
        "resolved"
      ],
      "properties": {
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "steps"
          ],
          "properties": {
            "base": {
              "description": "Replicant base image (replicant/base-<language>) by digest.",
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/image_by_digest"
            },
            "platform": {
              "type": "string",
              "enum": [
                "linux/amd64",
                "linux/arm64"
              ],
              "default": "linux/amd64"
            },
            "packages": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apt": {
                  "type": "array",
                  "maxItems": 200,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9+.-]*(=[A-Za-z0-9.:~+-]+)?$"
                  }
                },
                "npmGlobal": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "pattern": "^(@[a-z0-9-]+/)?[a-z0-9._-]+@[0-9][A-Za-z0-9.+-]*$"
                  }
                },
                "pipx": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+==[0-9][A-Za-z0-9.+-]*$"
                  }
                },
                "goInstall": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9.-]+(/[A-Za-z0-9._~-]+)+@v[0-9][A-Za-z0-9.+-]*$"
                  }
                }
              }
            },
            "steps": {
              "description": "Image-time setup steps (become image layers). Run with network access only to package mirrors.",
              "type": "array",
              "maxItems": 30,
              "items": {
                "$ref": "#/$defs/step"
              }
            },
            "bakeFromRepo": {
              "description": "Optional dependency pre-warming: at image build, CI checks out the repo at the given lockfile paths only and runs the steps, so dependency caches (go mod, npm cache, Maven ~/.m2) are image layers. Rebuilt when any listed lockfile's hash changes (the hashes are part of the build spec digest).",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repoId",
                "lockfiles",
                "steps"
              ],
              "properties": {
                "repoId": {
                  "type": "string",
                  "maxLength": 64
                },
                "lockfiles": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "sha256": {
                        "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/sha256_hex"
                      }
                    }
                  }
                },
                "steps": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "$ref": "#/$defs/step"
                  }
                }
              }
            }
          }
        },
        "resolved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "image",
            "buildSpecDigest"
          ],
          "properties": {
            "image": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/image_by_digest"
            },
            "buildSpecDigest": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/digest"
            },
            "sbomDigest": {
              "description": "Digest of the SPDX SBOM attestation (cosign attest --type spdxjson).",
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/digest"
            },
            "builtAt": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/timestamp"
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "run": {
          "description": "Shell script executed with /bin/bash -euo pipefail -c. Must be idempotent.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "workingDir": {
          "description": "Relative to /workspace/repo for bootstrap steps; absolute for image steps.",
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600,
          "default": 900
        },
        "env": {
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/env_map"
        },
        "when": {
          "description": "Run only if every listed path exists relative to the working directory (for example package-lock.json).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pathsExist": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "onFailure": {
          "type": "string",
          "enum": [
            "fail",
            "continue"
          ],
          "default": "fail"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "path": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^/[A-Za-z0-9._/-]+$"
        },
        "kind": {
          "description": "image: populated at image build (read-only lower layer; tools write misses to the overlay). workspace: a directory on the workspace volume, counted in workspace.sizeLimit, discarded at run end. tmpfs: memory-backed (counts against the memory limit).",
          "type": "string",
          "enum": [
            "image",
            "workspace",
            "tmpfs"
          ]
        },
        "env": {
          "description": "Environment variable pointing the tool at the cache (for example GOMODCACHE, npm_config_cache, PIP_CACHE_DIR, GRADLE_USER_HOME).",
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/env_name"
        },
        "sizeLimit": {
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/disk_quantity"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "ports",
        "readiness",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,30}$"
        },
        "image": {
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/image_by_digest"
        },
        "command": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "args": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "env": {
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/env_map"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "port"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,14}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcpPort": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "exec": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "httpGet": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port",
                "path"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                },
                "path": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^/"
                }
              }
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 2
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 60
            }
          },
          "minProperties": 1,
          "description": "Readiness check. Rendered as the sidecar's startupProbe for non-QA roles; for role qa it is NOT rendered (XD-05-14, XD-02-15): the replicant-qa harness waits and reports a classified service failure (exit 45)."
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "forRoles": {
          "description": "Roles whose AgentRun pods get this service. Default [qa].",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/run_role"
          }
        },
        "seed": {
          "description": "Optional bootstrap step run by the entrypoint after readiness (migrations, fixtures).",
          "$ref": "#/$defs/step"
        },
        "data": {
          "description": "Service data directory (XD-02-15): always under the enforced workspace at /workspace/.services/<name>[/<subdir>], never a separate emptyDir, so an overrun gives ENOSPC instead of eviction. `env` names the variable the controller sets to that path (for example PGDATA). Measured baselines already include service data in the workspace peak (it lives on the workspace volume); sizeEstimate is used for provisional profiles and by lint: every profile used by a role in forRoles must have workspace.sizeLimit ≥ Σ sizeEstimate + 10Gi.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "env",
            "sizeEstimate"
          ],
          "properties": {
            "env": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/env_name"
            },
            "subdir": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
            },
            "sizeEstimate": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/disk_quantity"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/cpu_quantity"
            },
            "memory": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            },
            "ephemeralStorage": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/cpu_quantity"
            },
            "memory": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            },
            "ephemeralStorage": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            }
          }
        }
      }
    },
    "resourceProfile": {
      "description": "Maps onto AgentRun spec.resources (main container; the controller adds sidecar and service requests) and spec.workspace. Runtime overhead is NOT added here: it is declared on the RuntimeClass (overhead.podFixed) by WS-02 from the same measurements (D-12, C-CRD).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits",
        "workspace",
        "derivation"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeralStorage"
          ],
          "properties": {
            "cpu": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/cpu_quantity"
            },
            "memory": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            },
            "ephemeralStorage": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeralStorage"
          ],
          "properties": {
            "cpu": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/cpu_quantity"
            },
            "memory": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            },
            "ephemeralStorage": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/byte_quantity"
            }
          }
        },
        "memoryRequestPolicy": {
          "description": "D-12 as amended by accepted ADR-03-008: median_peak (gVisor and runc: request = container p50 memory peak) or host_footprint (Kata: request = host-side pod footprint p50, or = limits.memory when the p50 footprint ratio is ≥ 0.8). match_limit forces request = limit. rp-2 (tools/rp1.py) chooses the value from the baseline's runtimeClass; CI recomputes it.",
          "type": "string",
          "enum": [
            "median_peak",
            "host_footprint",
            "match_limit"
          ],
          "default": "median_peak"
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sizeLimit",
            "overflow"
          ],
          "properties": {
            "sizeLimit": {
              "description": "AgentRun spec.workspace.sizeLimit: the hard workspace limit (enforcement mechanism chosen by WS-02 per runtime class, ADR-014). Must be <= limits.ephemeralStorage when backing resolves to emptyDir.",
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/disk_quantity"
            },
            "overflow": {
              "description": "Workspace backing (XD-FIX-R1-050/279; runner-service.md section 3.2 resolves it). never and local_only: emptyDir on node NVMe, admission fails (422) if sizeLimit exceeds the pool's local maximum (localMaxByPool). auto: generic ephemeral volume (EBS gp3) when sizeLimit > min(thresholdSize, localMax), else emptyDir. always: generic ephemeral volume. The StorageClass comes from WS-02's runtime-selection policy (workspace.overflowStorageClass), not from here. Deprecated aliases, accepted until WS-05's examples migrate (R1V-031): generic_ephemeral_volume_above = auto (thresholdSize required), always_generic_ephemeral_volume = always; with an alias, storageClassName is accepted and ignored (WS-02 policy's overflowStorageClass wins). tools/validate.py warns on aliases.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy"
              ],
              "properties": {
                "policy": {
                  "type": "string",
                  "enum": [
                    "never",
                    "auto",
                    "always",
                    "local_only",
                    "generic_ephemeral_volume_above",
                    "always_generic_ephemeral_volume"
                  ],
                  "default": "auto"
                },
                "thresholdSize": {
                  "description": "auto only: overflow above this size even when the pool's local maximum is larger. Absent: the pool's local maximum.",
                  "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/disk_quantity"
                },
                "storageClassName": {
                  "description": "Deprecated; accepted only with an alias policy and ignored.",
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "policy": {
                        "enum": [
                          "never",
                          "always",
                          "local_only",
                          "always_generic_ephemeral_volume"
                        ]
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "thresholdSize"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "policy": {
                        "const": "generic_ephemeral_volume_above"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "thresholdSize"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "policy": {
                        "enum": [
                          "never",
                          "auto",
                          "always",
                          "local_only"
                        ]
                      }
                    }
                  },
                  "then": {
                    "not": {
                      "required": [
                        "storageClassName"
                      ]
                    }
                  }
                }
              ]
            },
            "watchdogThresholds": {
              "description": "Disk watchdog (WS-02 sidecar) thresholds as fractions of sizeLimit: DiskPressure=ApproachingLimit at warn; WorkspaceDiskExceeded at fail.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "warn": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 0.99,
                  "default": 0.85
                },
                "fail": {
                  "type": "number",
                  "minimum": 0.9,
                  "maximum": 1.0,
                  "default": 0.98
                }
              }
            }
          }
        },
        "derivation": {
          "$ref": "#/$defs/derivation"
        }
      }
    },
    "derivation": {
      "description": "Evidence for the numbers (D-12: profiles derive from measured baselines). method=measured requires the statistics; method=provisional is allowed only with a reason and expires (CI fails the publish of a provisional profile older than expiresAt).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "measured",
            "provisional"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "expiresAt": {
          "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/timestamp"
        },
        "proposalId": {
          "description": "Right-sizing proposal that produced these numbers (rsp_<ulid>).",
          "type": "string",
          "pattern": "^rsp_[0-9a-hjkmnp-tv-z]{26}$"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codebaseType",
            "roles",
            "runtimeClass",
            "windowStart",
            "windowEnd",
            "sampleCount",
            "formulaVersion"
          ],
          "properties": {
            "codebaseType": {
              "type": "string",
              "maxLength": 32
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/run_role"
              }
            },
            "runtimeClass": {
              "type": "string",
              "enum": [
                "replicant-gvisor",
                "replicant-kata-fc",
                "replicant-kata-clh"
              ]
            },
            "windowStart": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/timestamp"
            },
            "windowEnd": {
              "$ref": "https://schemas.replicant.example.com/kinds/common/v1.json#/$defs/timestamp"
            },
            "sampleCount": {
              "type": "integer",
              "minimum": 1
            },
            "formulaVersion": {
              "type": "string",
              "enum": [
                "rp-1",
                "rp-2"
              ]
            },
            "stats": {
              "description": "Per-run peak statistics (bytes for memory/disk, millicores for CPU over the 60 s window). Recorded so reviewers can recompute the formula.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuMillicoresP50": {
                  "type": "integer",
                  "minimum": 0
                },
                "cpuMillicoresP95": {
                  "type": "integer",
                  "minimum": 0
                },
                "memoryBytesP50": {
                  "type": "integer",
                  "minimum": 0
                },
                "memoryBytesP95": {
                  "type": "integer",
                  "minimum": 0
                },
                "workspaceBytesP50": {
                  "type": "integer",
                  "minimum": 0
                },
                "workspaceBytesP95": {
                  "type": "integer",
                  "minimum": 0
                },
                "ephemeralBytesP50": {
                  "type": "integer",
                  "minimum": 0
                },
                "ephemeralBytesP95": {
                  "type": "integer",
                  "minimum": 0
                },
                "hostFootprintBytesP50": {
                  "description": "p50 of the per-run peak host-side pod footprint attributable to the agent container (pod cgroup working-set peak minus service peaks minus RuntimeClass overhead.podFixed.memory). Required for Kata runtime classes under rp-2.",
                  "type": "integer",
                  "minimum": 0
                },
                "hostFootprintBytesP95": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "measured"
              }
            }
          },
          "then": {
            "required": [
              "baseline"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "provisional"
              }
            }
          },
          "then": {
            "required": [
              "reason",
              "expiresAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "measured"
              },
              "baseline": {
                "properties": {
                  "formulaVersion": {
                    "const": "rp-2"
                  },
                  "runtimeClass": {
                    "enum": [
                      "replicant-kata-clh",
                      "replicant-kata-fc"
                    ]
                  }
                },
                "required": [
                  "formulaVersion",
                  "runtimeClass"
                ]
              }
            },
            "required": [
              "method",
              "baseline"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "properties": {
                  "stats": {
                    "required": [
                      "hostFootprintBytesP50"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
